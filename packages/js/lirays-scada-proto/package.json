{
  "name": "@lirays/scada-proto",
  "version": "0.1.4",
  "description": "Generated protobuf types for LiRAYS SCADA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiRAYSgj/LiRAYS-SCADA-proto"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "devDependencies": {
    "ts-proto": "^2.11.5",
    "typescript": "^5.6.3"
  }
}
